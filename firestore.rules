rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reads stay open everywhere -- every site in this ecosystem (including the cadet-facing Memo
    // Submissions site) reads from this same database with no login, and none of that is changing.
    match /{document=**} {
      allow read: if true;
    }

    // Owned exclusively by Accountability/Memorandums -- no other site (including the TO Tracker,
    // which has no login of its own) ever writes these, so requiring a signed-in account here is a
    // real, uncompromised security boundary.
    match /emailTemplates/{id} { allow write: if request.auth != null; }
    match /extraEvents/{id} { allow write: if request.auth != null; }
    match /extraEventAttendance/{id} { allow write: if request.auth != null; }

    // Shared across Accountability, Memorandums, and Memo Submissions -- now that all three
    // require a signed-in account (every cadet has their own login), this is safe to lock down
    // too: nothing left writes here without auth.
    match /attendance/{id} { allow write: if request.auth != null; }
    match /absenceMemos/{id} { allow write: if request.auth != null; }
    match /deviationMemos/{id} { allow write: if request.auth != null; }

    // Still written by the TO Tracker, which has no login of its own -- requiring auth here would
    // break it. Closing this gap for real needs giving the TO Tracker its own login too, which
    // wasn't asked for here.
    match /cadets/{id} { allow write: if true; }
    match /pmtEvents/{id} { allow write: if true; }
    match /trainingObjectives/{id} { allow write: if true; }
    match /completions/{id} { allow write: if true; }

    // Maintenance mode -- locks every signed-in user except Cortes Garay out of the whole app
    // (App.tsx), so only he may toggle it. A real server-enforced boundary, not just a client-side
    // check like most of this app's per-tab permissions -- a client-side-only gate here would let
    // anyone with dev tools re-enable write access to flip it.
    match /siteConfig/{id} {
      allow write: if request.auth != null && request.auth.token.email == "jorge.cortes4@upr.edu";
    }
  }
}
