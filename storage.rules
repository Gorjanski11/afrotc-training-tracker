rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Matches this project's established Firestore posture (see firestore.rules) -- any signed-in
    // account can read/write/delete; the UI (Settings > Data Management, gated further to Cortes
    // Garay with a password re-check for deletes) is what actually restricts who reaches this.
    match /{allPaths=**} {
      allow read, write, delete: if request.auth != null;
    }
  }
}
